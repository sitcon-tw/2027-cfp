{
  "name": "2027-cfp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/only-allow-pnpm.js",
    "postinstall": "cn-font-split i default@7.6.8",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest run",
    "api:dev": "cd worker && wrangler dev --env staging",
    "api:deploy": "cd worker && wrangler deploy --env=\"\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cn-font-split": "7.4.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-font": "^5.1.2",
    "vitest": "^5.0.3",
    "wrangler": "4.143.0"
  }
}
