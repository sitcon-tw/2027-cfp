# Copy to `worker/.dev.vars` (git-ignored) for `pnpm api:dev`.
# Point SHEET_ID at a test sheet shared with the service account, never the
# real one.
SHEET_ID=""
# The service account's JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","client_email":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"}'
# Any long random string, e.g. `openssl rand -base64 32`.
TOKEN_SECRET=""
# Cloudflare's always-pass test key; pair it with the site key
# 1x00000000000000000000AA (VITE_TURNSTILE_SITE_KEY) when running locally.
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
